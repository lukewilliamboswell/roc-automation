expect BoundedInflate.decompress([115, 4, 0], 1) == Ok([65])
expect BoundedInflate.decompress([115, 4, 0], 0) == Err(OutputLimitExceeded)
expect BoundedInflate.decompress([115, 4, 0, 88], 1) == Err(TrailingBytes)
expect Png.decode([]).is_err()

expect {
	var $raw = []
	for _index in 0..<4097.U64 {
		$raw = $raw.concat([0, 0, 0, 255, 255])
	}
	$raw = $raw.concat([1, 0, 0, 255, 255])
	BoundedInflate.decompress($raw, 0) == Err(WorkLimitExceeded)
}
expect BoundedInflate.decompress([0, 0, 0, 255, 255, 1, 0, 0, 255, 255], 0) == Ok([])
